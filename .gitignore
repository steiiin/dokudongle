# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/
*.env

hardware/keyboard-sender/xiao_bootloader/Adafruit*

*.log
log.txt
npm-debug.log*
*.codex
*.FCBak

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode/*
!/.vscode/extensions.json
!/.vscode/tasks.json
/.firmware-build.lock
/coverage
/dist
/node_modules
/platforms
/plugins
/www

# Generated browser test output
/tests/e2e/screenshots/
/tests/e2e/videos/

# Local Android Studio device selection
/android/.idea/deviceManager.xml
/android/.idea/deploymentTargetSelector.xml
